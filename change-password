<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Change Password — Smart Choice Delivery</title>
<style>
:root{--bg:#FAF7F2;--card:#fff;--ink:#2B2620;--ink-soft:#6B6256;--border:#E6DECF;--accent:#0C769E;--warm:#B8472B;--green:#2C6B2C;--green-soft:#EAF4EA;--red-soft:#F8DEDA;}
*{box-sizing:border-box;}body{margin:0;background:var(--bg);color:var(--ink);font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;}
.topbar{background:var(--card);border-bottom:3px solid var(--warm);padding:14px 20px;}.topbar h1{font-family:Georgia,serif;font-size:19px;margin:0;font-weight:600;}
.main{max-width:420px;margin:0 auto;padding:18px 16px;}
.card{background:var(--card);border:1px solid var(--border);border-radius:12px;padding:18px;}
label{display:block;font-size:12px;color:var(--ink-soft);margin:12px 0 4px;}
input{width:100%;padding:10px;border:1px solid var(--border);border-radius:8px;font-size:15px;}
button{margin-top:16px;width:100%;background:var(--accent);color:#fff;border:0;border-radius:8px;padding:11px;font-size:15px;cursor:pointer;}button:disabled{opacity:.6;}
.msg{padding:9px 12px;border-radius:8px;margin-top:12px;font-size:13px;}.err{background:var(--red-soft);color:var(--warm);}.ok{background:var(--green-soft);color:var(--green);}
a{color:var(--accent);font-size:13px;text-decoration:none;}
</style>
</head>
<body>
<div class="topbar"><h1>Change Password</h1></div>
<div class="main">
  <p><a href="/hub.html">&larr; Hub</a></p>
  <form class="card" id="f" autocomplete="on">
    <input type="text" id="u" autocomplete="username" hidden>
    <label for="cur">Current password</label><input id="cur" type="password" autocomplete="current-password" required>
    <label for="nw">New password (at least 10 characters)</label><input id="nw" type="password" autocomplete="new-password" required minlength="10">
    <label for="nw2">Confirm new password</label><input id="nw2" type="password" autocomplete="new-password" required minlength="10">
    <button id="go" type="submit">Change password</button>
    <div id="msg" class="msg" hidden></div>
  </form>
  <p style="font-size:12px;color:var(--ink-soft);margin-top:12px;">Other devices signed in with this account will be signed out. This device stays signed in. There is no "forgot password" option, so keep the new password somewhere safe.</p>
</div>
<script>
function msg(t,c){var m=document.getElementById('msg');m.className='msg '+c;m.textContent=t;m.hidden=!t;}
fetch('/api/auth?action=check').then(function(r){return r.json();}).then(function(d){
  if(!d.authenticated)location.href='/login.html?redirect='+encodeURIComponent(location.pathname);
  else document.getElementById('u').value=d.username||'';
}).catch(function(){location.href='/login.html?redirect='+encodeURIComponent(location.pathname);});
document.getElementById('f').addEventListener('submit',async function(e){
  e.preventDefault();
  var cur=document.getElementById('cur').value, nw=document.getElementById('nw').value, nw2=document.getElementById('nw2').value;
  if(nw!==nw2){msg('The new passwords do not match.','err');return;}
  var b=document.getElementById('go');b.disabled=true;
  try{
    var r=await fetch('/api/auth?action=change-password',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({current_password:cur,new_password:nw})});
    var d=await r.json().catch(function(){return {};});
    if(!r.ok){msg(d.error||('Could not change password ('+r.status+')'),'err');}
    else{msg('Password changed. Use the new one next time you sign in.','ok');document.getElementById('f').reset();}
  }catch(x){msg('Could not change password: '+x.message,'err');}
  finally{b.disabled=false;}
});
</script>
</body>
</html>
